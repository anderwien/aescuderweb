---
interface Props {
  href?: string;
  eyebrow?: string;
  title: string;
  description: string;
}

const { href, eyebrow, title, description } = Astro.props;
const Tag = href ? 'a' : 'article';
---

<Tag class="card" href={href}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h3>{title}</h3>
  <p>{description}</p>
  <slot />
</Tag>

<style>
  .card {
    display: grid;
    min-height: 100%;
    align-content: start;
    gap: var(--space-sm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.32);
    color: var(--color-ink);
    padding: var(--space-lg);
    text-decoration: none;
  }

  .card:hover {
    border-color: var(--color-accent-blue);
    color: var(--color-ink);
  }

  h3 {
    font-size: 2.25rem;
  }

  p:not(.eyebrow) {
    color: var(--color-charcoal);
  }
</style>
