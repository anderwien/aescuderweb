---
interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  href: string;
  label: string;
}

const { eyebrow, title, description, href, label } = Astro.props;
---

<section class="cta container">
  <div class="cta__text">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2>{title}</h2>
    <p>{description}</p>
  </div>
  <a class="button" data-variant="filled" href={href}>{label}</a>
</section>

<style>
  .cta {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-xl);
    border-block: 1px solid var(--color-border);
    margin-top: var(--space-3xl);
    padding-block: var(--space-2xl);
  }

  .cta__text {
    display: grid;
    flex: 1 1 auto;
    max-width: 920px;
    gap: var(--space-sm);
  }

  h2 {
    max-width: 100%;
  }

  p:not(.eyebrow) {
    color: var(--color-charcoal);
    font-size: 1rem;
  }

  @media (max-width: 720px) {
    .cta {
      align-items: start;
      flex-direction: column;
    }
  }
</style>
