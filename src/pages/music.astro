---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import Hero from '../components/Hero.astro';
import MusicCatalog from '../components/MusicCatalog';
import Section from '../components/Section.astro';
import { byOrder } from '../lib/content';

const music = (await getCollection('music')).sort(byOrder);
const page = await getEntry('pages', 'music');
if (!page) {
  throw new Error('Missing music page content.');
}
const catalogItems = music.map((item) => ({
  id: item.id,
  title: item.data.title,
  description: item.data.description,
  year: item.data.year,
  type: item.data.type,
  category: item.data.category,
  featuredGroup: item.data.featuredGroup,
  duration: item.data.duration,
  instrumentation: item.data.instrumentation,
  details: item.data.details,
  tags: item.data.tags,
  coverImage: item.data.coverImage,
  url: item.data.url,
  audioUrl: item.data.audioUrl,
  youtubeUrl: item.data.youtubeUrl,
  scoreUrl: item.data.scoreUrl,
  storeUrl: item.data.storeUrl
}));

const videoSections = [
  {
    id: 'piano-repertoire',
    eyebrow: 'Piano repertoire',
    title: 'Piano Repertoire',
    description:
      'Selected piano performances and repertoire notes. This section is ready for YouTube videos, recordings, or featured repertoire entries.',
    items: page.data.pianoRepertoire ?? []
  },
  {
    id: 'piano-improvisations',
    eyebrow: 'Improvisation',
    title: 'Piano Improvisations',
    description:
      'Improvised performances, live musical responses, sketches, and experiments at the piano.',
    items: page.data.pianoImprovisations ?? []
  }
];
---

<BaseLayout title={page.data.seoTitle ?? page.data.title} description={page.data.seoDescription ?? page.data.description}>
  <Hero
    eyebrow="Music"
    title={page.data.title}
    description={page.data.description}
    image={page.data.heroImage}
  />

  <Section
    eyebrow="Works"
    title={page.data.catalogueTitle ?? 'Catalogue of works'}
    description={page.data.catalogueDescription ?? 'Browse compositions, music for media, jazz projects, and piano-related work.'}
    compact
  >
    <div id="works">
      <MusicCatalog items={catalogItems} client:load />
    </div>
  </Section>

  {
    videoSections.map((section) => (
      <Section id={section.id} eyebrow={section.eyebrow} title={section.title} description={section.description}>
        <div class="video-placeholder-grid">
          {section.items.length > 0 ? (
            section.items.map((item) => (
              <article class="video-placeholder">
                <img src={item.image ?? '/images/piano-portrait.jpg'} alt="" loading="lazy" />
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                  {item.youtubeUrl ? (
                    <a class="button" href={item.youtubeUrl}>Watch video</a>
                  ) : (
                    <span>Ready for YouTube, audio, or notes</span>
                  )}
                </div>
              </article>
            ))
          ) : (
            <article class="video-placeholder">
              <img src="/images/piano-portrait.jpg" alt="" loading="lazy" />
              <div>
                <h3>{section.title}</h3>
                <p>Add entries in <code>src/content/pages/music.md</code> to publish videos or recordings here.</p>
                <span>Markdown controlled</span>
              </div>
            </article>
          )}
        </div>
      </Section>
    ))
  }

  <CTA
    eyebrow="Inquiry"
    title="Interested in a score, recording, or collaboration?"
    description="Send a professional inquiry with the context, deadline, and what you would like to explore."
    href="/contact"
    label="Contact"
  />
</BaseLayout>

<style>
  #works {
    scroll-margin-top: calc(var(--header-height) + 2rem);
  }

  .video-placeholder-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-lg);
  }

  .video-placeholder {
    display: grid;
    grid-template-columns: minmax(8rem, 0.38fr) minmax(0, 1fr);
    gap: var(--space-lg);
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: 1.1rem;
    background: var(--color-surface);
    padding: var(--space-md);
  }

  .video-placeholder img {
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 0.8rem;
    filter: grayscale(1);
    object-fit: cover;
  }

  .video-placeholder div {
    display: grid;
    gap: var(--space-sm);
  }

  .video-placeholder h3 {
    font-size: 2.2rem;
  }

  .video-placeholder p {
    color: var(--color-charcoal);
    font-size: 1rem;
    line-height: 1.6;
  }

  .video-placeholder span {
    color: var(--color-muted);
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .video-placeholder .button {
    width: fit-content;
  }

  @media (max-width: 820px) {
    .video-placeholder-grid,
    .video-placeholder {
      grid-template-columns: 1fr;
    }
  }
</style>
