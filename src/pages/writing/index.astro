---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTA from '../../components/CTA.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import WritingGrid from '../../components/WritingGrid';
import { byDateDesc, formatDate, isPublished } from '../../lib/content';

const writing = (await getCollection('writing')).filter(isPublished).sort((a, b) => {
  if (a.data.pinned && !b.data.pinned) return -1;
  if (!a.data.pinned && b.data.pinned) return 1;
  return byDateDesc(a, b);
});
const page = await getEntry('pages', 'writing');
if (!page) {
  throw new Error('Missing writing page content.');
}
const writingItems = writing.map((item) => ({
  id: item.id,
  title: item.data.title,
  description: item.data.description,
  date: formatDate(item.data.date),
  image: item.data.image,
  readTime: item.data.readTime,
  tags: item.data.tags,
  category: item.data.category,
  pinned: item.data.pinned
}));
---

<BaseLayout title={page.data.seoTitle ?? page.data.title} description={page.data.seoDescription ?? page.data.description}>
  <Hero
    eyebrow="Writing"
    title={page.data.title}
    description={page.data.description}
    image={page.data.heroImage}
  />

  <Section compact>
    <WritingGrid items={writingItems} client:load />
  </Section>

  <CTA
    eyebrow="Conversation"
    title="Writing can open a better question."
    description="For essays, talks, workshops, or thoughtful collaborations, send a professional inquiry."
    href="/contact"
    label="Contact"
  />
</BaseLayout>
