---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTA from '../../components/CTA.astro';
import Section from '../../components/Section.astro';
import { formatDate, isPublished } from '../../lib/content';

export async function getStaticPaths() {
  const posts = (await getCollection('writing')).filter(isPublished);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="article-header container">
    <p class="eyebrow">{formatDate(post.data.date)}</p>
    <h1>{post.data.title}</h1>
    <p>{post.data.description}</p>
    {
      post.data.tags && post.data.tags.length > 0 && (
        <ul aria-label="Writing tags">
          {post.data.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      )
    }
  </article>

  <Section compact>
    <article class="reading-container prose">
      <Content />
    </article>
  </Section>

  <CTA
    eyebrow="Archive"
    title="Return to the essays."
    description="Browse more writing on music, education, attention, and artistic practice."
    href="/writing"
    label="All writing"
  />
</BaseLayout>

<style>
  .article-header {
    display: grid;
    gap: var(--space-md);
    border-bottom: 1px solid var(--color-border);
    padding-block: var(--space-3xl) var(--space-2xl);
  }

  h1 {
    max-width: 12ch;
  }

  .article-header > p:not(.eyebrow) {
    max-width: 720px;
    color: var(--color-charcoal);
    font-size: 1.2rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
  }

  li {
    color: var(--color-muted);
    font-size: 0.9rem;
  }
</style>
